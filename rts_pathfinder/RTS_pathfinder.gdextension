[configuration]
entry_symbol = "rts_pathfinder_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
macos.debug = "bin/librts_pathfinder.macos.template_debug.universal.dylib"
macos.release = "bin/librts_pathfinder.macos.template_release.universal.dylib"

linux.debug.x86_64 = "bin/librts_pathfinder.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/librts_pathfinder.linux.template_release.x86_64.so"

windows.debug.x86_64 = "bin/librts_pathfinder.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/librts_pathfinder.windows.template_release.x86_64.dll"
